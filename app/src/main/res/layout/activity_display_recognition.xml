<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".display.view.DisplayRecognitionActivity">

    <!-- Vista de cámara OpenCV -->
    <org.opencv.android.JavaCameraView
        android:id="@+id/camera_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Texto de resultado principal -->
    <TextView
        android:id="@+id/tvResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="120dp"
        android:background="#CC000000"
        android:gravity="center"
        android:padding="20dp"
        android:text=""
        android:textColor="@android:color/white"
        android:textSize="48sp"
        android:textStyle="bold"
        android:fontFamily="monospace" />

    <!-- ✅ NUEVO: TextView para debug (detecciones RAW) -->
    <TextView
        android:id="@+id/tvDebug"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@id/tvResult"
        android:layout_marginBottom="8dp"
        android:background="#AA000000"
        android:padding="12dp"
        android:text=""
        android:textColor="#FFFF00"
        android:textSize="14sp"
        android:fontFamily="monospace"
        android:maxLines="3"
        android:scrollbars="vertical" />

    <!-- Indicador de procesamiento -->
    <TextView
        android:id="@+id/tvProcessing"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="#AA000000"
        android:padding="8dp"
        android:text="🔍 Detectando..."
        android:textColor="#00FF00"
        android:textSize="16sp"
        android:visibility="gone" />

</RelativeLayout>