<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@android:color/black"
    android:padding="32dp">

    <ImageView
        android:id="@+id/ivLogo"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/logo_irislens_redondeado"
        android:contentDescription="Logo de Iris Lens"
        android:layout_marginBottom="24dp"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="327dp"
        android:layout_height="wrap_content"
        android:contentDescription="Iris Lens le da la bienvenida. Deslice con el dedo hacia la izquierda o derecha para cambiar de funcionalidad. Use doble toque para detener la voz."
        android:gravity="center"
        android:lineSpacingExtra="8dp"
        android:text="Iris Lens le da la bienvenida. \n\nDeslice con el dedo hacia la izquierda o derecha para cambiar de funcionalidad. \n\nUse doble toque para detener la voz."
        android:textAlignment="center"
        android:textColor="@android:color/white"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>
